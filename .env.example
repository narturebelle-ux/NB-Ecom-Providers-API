# The same Supabase database and Firebase project as NB-Ecom-API.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Base64 of 32 random bytes, e.g. `openssl rand -base64 32`. Losing it makes stored PAN and bank numbers unreadable.
DATA_ENCRYPTION_KEY=
RESEND_API_KEY=
PORT=8086
# Comma-separated, only if you need more than the defaults in application.yml.
# CORS_ALLOWED_ORIGINS=
# prod only: stays false until the real fees, agreement and training text are in place.
AGREEMENT_SIGNING_ENABLED=false
